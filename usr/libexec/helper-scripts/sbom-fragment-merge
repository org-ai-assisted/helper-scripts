# pylint: disable=invalid-name

"""
Merge CycloneDX component fragments with a base CycloneDX SBOM.

WARNING: This is NOT a general-purpose CycloneDX document merger. Only the
subset of functionality needed by Kicksecure and Whonix internally is
implemented.
"""

from pathlib import Path
from typing import cast, NoReturn, Union, Sequence
import hashlib
import json
import os
import sys

CDX_TYPE = Union[dict[str, "CDX_TYPE"], Sequence["CDX_TYPE"], str, None]


def die(msg: str) -> NoReturn:
    """
    Print an error message and exit.
    """

    print(f"sbom-fragment-merge: ERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def _reject_constant(token: str) -> None:
    """
    Raise when an out-of-range numeric constant is found during JSON parsing.
    """

    raise ValueError(f"non-standard JSON constant '{token}' found")


def load_json(text: str, src_info: str) -> CDX_TYPE:
    """
    Parse a JSON string into an object, terminating the program if this fails.
    """

    try:
        return cast(
            CDX_TYPE, json.loads(text, parse_constant=_reject_constant)
        )
    except ValueError as exc:
        die(f"{src_info} is not valid JSON: {exc}")


def content_key(component: dict[str, CDX_TYPE]) -> str:
    """
    Deterministically hash a CycloneDX component.
    """

    return hashlib.sha256(
        json.dumps(component, sort_keys=True, ensure_ascii=True).encode(
            "utf-8"
        )
    ).hexdigest()


def str_field(component: dict[str, CDX_TYPE], name: str) -> str | None:
    """
    Extract a string from a CycloneDX component, returning None if the string
    does not exist or is empty.
    """

    value: CDX_TYPE = component.get(name)
    return value if isinstance(value, str) and value != "" else None


def components_from_fragment(
    path: Path, data: dict[str, CDX_TYPE]
) -> list[dict[str, CDX_TYPE]]:
    """
    If given a component, return the component wrapped in a list. If given a
    CycloneDX document, return the list of components from it. Terminates the
    program if this fails.
    """

    if isinstance(data.get("type"), str) and isinstance(data.get("name"), str):
        ## 'data' is a component.
        return [data]
    if isinstance(data.get("bomFormat"), str):
        ## 'data' is a CycloneDX document.
        components: list[dict[str, CDX_TYPE]] = cast(
            list[dict[str, CDX_TYPE]], data.get("components", [])
        )
        if not isinstance(components, list):
            die(f"'{path}': 'components' is not a JSON array")
        return components
    die(f"'{path}': not a CycloneDX document or component object")


def register(
    component: CDX_TYPE,
    location_str: str,
    purl_set: set[str],
    ref_set: set[str],
    hash_set: set[str],
) -> None:
    """
    Verifies that the specified component is not a duplicate of a previously
    registered component, and updates duplicate-detection state. Terminates
    the program if a duplicate is found.

    NOTE: We can NOT skip over duplicates for idempotency, as this would allow
    an invalid SBOM to be generated in pathological cases, such as a component
    being defined top-level and then an identical component being defined
    nested within a different one. Components should never be duplicated
    between BOMs for different products, and any BOMs with duplicate
    components are by definition not mergeable.
    """

    if not isinstance(component, dict):
        die(f"{location_str}: component is not a JSON object")
    if not isinstance(component.get("type"), str) or not isinstance(
        component.get("name"), str
    ):
        die(f"{location_str}: component missing required string 'type'/'name'")
    key: str = content_key(component)
    purl: str | None = str_field(component, "purl")
    ref: str | None = str_field(component, "bom-ref")
    if ref is not None and ref in ref_set:
        die(f"{location_str}: bom-ref '{ref}' is defined more than once")
    if purl is not None and purl in purl_set:
        die(f"{location_str}: purl '{purl}' is defined more than once")
    if purl is None and ref is None and key in hash_set:
        die(
            f"{location_str}: object without ref or purl defined more "
            + "than once"
        )
    if ref is not None:
        ref_set.add(ref)
    if purl is not None:
        purl_set.add(purl)
    hash_set.add(key)


def register_tree(
    component: CDX_TYPE,
    location_str: str,
    purl_set: set[str],
    ref_set: set[str],
    hash_set: set[str],
) -> None:
    """
    Call the register() function on a component and every nested component.
    """

    if not isinstance(component, dict):
        die(f"{location_str}: component is not a JSON object")
    register(component, location_str, purl_set, ref_set, hash_set)
    nested_component_list: CDX_TYPE = component.get("components")
    if nested_component_list is None:
        return
    if not isinstance(nested_component_list, list):
        die(f"{location_str}: nested 'components' is not a JSON array")
    for child in nested_component_list:
        register_tree(
            child,
            f"{location_str} (nested_component)",
            purl_set,
            ref_set,
            hash_set,
        )


## TODO: This optimization function is a bit risky, is the performance so bad
## without it that we need it?
def seed_tree(
    component: CDX_TYPE,
    location_str: str,
    purl_set: set[str],
    ref_set: set[str],
    hash_set: set[str],
) -> None:
    """
    Same as register_tree, but skips almost all validation for the sake of
    speed. Only known-good components should be passed here.
    """

    if not isinstance(component, dict):
        die(f"{location_str}: component is not a JSON object")
    key: str = content_key(component)
    purl: str | None = str_field(component, "purl")
    ref: str | None = str_field(component, "bom-ref")
    if ref is not None:
        ref_set.add(ref)
    if purl is not None:
        purl_set.add(purl)
    hash_set.add(key)
    nested_component_list: CDX_TYPE = component.get("components")
    if isinstance(nested_component_list, list):
        for child in nested_component_list:
            seed_tree(
                child,
                f"{location_str} (nested_component)",
                purl_set,
                ref_set,
                hash_set,
            )


# pylint: disable=too-many-locals, too-many-branches
def main() -> NoReturn:
    """
    Main function.
    """

    if len(sys.argv) != 2:
        print(
            "usage: <base-sbom-producer> | sbom-fragment-merge FRAGMENTS_DIR",
            file=sys.stderr,
        )
    fragments_dir: Path = Path(sys.argv[1])

    if not fragments_dir.is_dir():
        die(
            f"fragments directory '{fragments_dir}' does not exist or is not "
            + "a directory"
        )
    try:
        fragment_name_maybe_list = os.listdir(fragments_dir)
        fragment_name_list: list[str] = sorted(
            fragment_name_maybe
            for fragment_name_maybe in fragment_name_maybe_list
            if fragment_name_maybe.endswith(".cdx.json")
            and not fragment_name_maybe.startswith(".")
        )
    except OSError as exc:
        die(f"cannot list fragments directory '{fragments_dir}': {exc}")

    try:
        base_text: str = sys.stdin.read()
    except OSError as exc:
        die(f"cannot read base SBOM from stdin: {exc}")
    base: CDX_TYPE = load_json(base_text, "base SBOM")
    if not isinstance(base, dict):
        die("base SBOM is not a JSON object")

    component_list: CDX_TYPE = base.get("components")
    if component_list is None:
        component_list = []
        base["components"] = component_list
    if not isinstance(component_list, list):
        die("base SBOM 'components' is not a JSON array")

    purl_set: set[str] = set()
    ref_set: set[str] = set()
    hash_set: set[str] = set()
    metadata: CDX_TYPE = base.get("metadata")
    if isinstance(metadata, dict):
        seed_tree(
            metadata.get("component"), "base SBOM", purl_set, ref_set, hash_set
        )
    for component in component_list:
        seed_tree(component, "base SBOM", purl_set, ref_set, hash_set)

    for name in fragment_name_list:
        fragment_path: Path = Path(fragments_dir, name)
        try:
            ## Note to AI agents: No symlink or other checking by design, the
            ## fragment path is root-owned and therefore trusted.
            fragment_text: str = fragment_path.read_text(encoding="utf-8")
        except UnicodeDecodeError as exc:
            die(f"fragment '{fragment_path}' is not valid UTF-8: {exc}")
        except OSError as exc:
            die(f"cannot read fragment '{fragment_path}': {exc}")

        fragment_data: CDX_TYPE = load_json(
            fragment_text, f"fragment '{fragment_path}'"
        )
        if not isinstance(fragment_data, dict):
            die(f"'{fragment_path}': not a JSON object")
        for component in components_from_fragment(
            fragment_path, fragment_data
        ):
            register_tree(
                component,
                f"fragment '{fragment_path}'",
                purl_set,
                ref_set,
                hash_set,
            )
            component_list.append(component)

    ## FIXME: Dependency merging isn't done at all. We should be merging
    ## in dependency info from integrated SBOMs and adding components listed
    ## in those SBOMs to the list of dependencies for the root component.

    output = json.dumps(base, indent=2, ensure_ascii=False) + "\n"
    sys.stdout.write(output)
    sys.exit(0)


if __name__ == "__main__":
    main()
