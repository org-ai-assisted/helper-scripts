## provides was_executed
# shellcheck source=./check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh || true
if ! declare -F was_executed >/dev/null; then
   printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh!" >&2
   exit 1
fi

# shellcheck source=./strings.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/strings.bsh

# shellcheck source=./light_sleep.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/light_sleep.bsh

try_wait_for_system_ready() {
   local max_seconds wait_msg_printed counter system_ready_result

   max_seconds="${system_ready_wait_max_seconds:-180}"
   if [ -z "${max_seconds}" ] \
      || ! is_whole_number_int64 "${max_seconds}" \
      || [ "${max_seconds}" -lt 0 ] \
      || [ "${max_seconds}" -gt 99999 ]; then
      max_seconds='180'
   fi
   wait_msg_printed='false'

   for (( counter = 0; counter < ${max_seconds}; counter++ )); do
      system_ready_result="$(systemctl is-system-running || true)"
      if [[ "${system_ready_result}" =~ ^(running|degraded)$ ]]; then
         return 0
      elif [ "${wait_msg_printed}" = 'false' ]; then
         printf '%s\n' "$0: waiting for the system to finish starting..."
         wait_msg_printed='true'
      fi
      light_sleep 1
   done

   return 0
}

main() {
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
   export LC_ALL=C

   try_wait_for_system_ready
}

if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
