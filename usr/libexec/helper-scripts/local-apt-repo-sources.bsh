## style-ok: no-strict - sourced library.

## Given a file: URI pointing to a local apt repository, and accompanying
## metadata, outputs a deb822 sources stanza that will tell apt to use that
## repository.
local_apt_repo_sources_stanza() {
  local uri suite repo_path arch dist_path component_path component_str \
    component_list_str

  uri="${1:-}"
  suite="${2:-}"
  repo_path="${3:-}"
  arch="${4:-$(dpkg --print-architecture 2>/dev/null || printf '%s' amd64)}"

  if [ -z "${uri}" ] \
    || [ -z "${suite}" ]; then
    return 2
  fi

  if [ -z "${repo_path}" ]; then
    repo_path="${uri#file:}"
  fi
  dist_path="${repo_path}/dists/${suite}"
  component_list_str=""
  for component_path in "${dist_path}"/*/; do
    [ -d "${component_path}" ] || continue
    if [ -s "${component_path}binary-${arch}/Packages" ]; then
      component_str="${component_path%/}"
      component_str="${component_str##*/}"
      component_list_str="${component_list_str}${component_list_str:+ }${component_str}"
    fi
  done
  [ -n "${component_list_str}" ] || component_list_str="main"

  printf '%s\n' "Types: deb
URIs: ${uri}
Suites: ${suite}
Components: ${component_list_str}
Enabled: yes
Trusted: yes"
}
