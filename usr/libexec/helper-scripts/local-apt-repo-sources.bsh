## style-ok: no-strict - sourced library.

## Given a file: URI pointing to a local apt repository, and accompanying
## metadata, outputs a deb822 sources stanza that will tell apt to use that
## repository.
local_apt_repo_sources_stanza() {
  local uri suite repo_path arch dist_path component_path component_str \
    component_list_str

  uri="${1:-}"
  suite="${2:-}"
  repo_path="${3:-}"
  arch="${4:-$(dpkg --print-architecture 2>/dev/null || printf '%s' amd64)}"

  if [ -z "${uri}" ] \
    || [ -z "${suite}" ]; then
    return 2
  fi

  if [ -z "${repo_path}" ]; then
    repo_path="${uri#file:}"
  fi
  dist_path="${repo_path}/dists/${suite}"
  component_list_str=""
  for component_path in "${dist_path}"/*/; do
    [ -d "${component_path}" ] || continue
    if [ -s "${component_path}binary-${arch}/Packages" ]; then
      component_str="${component_path%/}"
      component_str="${component_str##*/}"
      component_list_str="${component_list_str}${component_list_str:+ }${component_str}"
    fi
  done
  ## Fail loud rather than emit a plausible-but-wrong stanza: an empty result
  ## means the scan dir is missing (wrong repo_path) or no component carries
  ## packages for this arch. A silent fallback to 'main' here previously hid a
  ## caller that passed a non-host URI as the scan path, dropping contrib/non-free
  ## and surfacing only much later as an apt 'Unable to locate package'.
  if [ -z "${component_list_str}" ]; then
    printf '%s\n' "${0##*/}: ERROR: local_apt_repo_sources_stanza: no component with a non-empty binary-${arch}/Packages under '${dist_path}'; refusing to emit a bogus sources stanza." >&2
    return 1
  fi

  printf '%s\n' "Types: deb
URIs: ${uri}
Suites: ${suite}
Components: ${component_list_str}
Enabled: yes
Trusted: yes"
}
