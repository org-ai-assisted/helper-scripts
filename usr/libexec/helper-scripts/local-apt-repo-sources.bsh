## style-ok: no-strict - sourced library.

## Single source of truth for the deb822 sources stanza of a derivative LOCAL
## apt repository (the reprepro 'local' repo built from source). Sourced by
## both the build-time mounter (derivative-maker help-steps/create-local-apt-repo)
## and the on-system enabler (repo-add-local), so the stanza can never drift
## between them.
##
## Trusted: yes is intrinsic to this stanza's purpose: a local throwaway file:
## repo is unsigned, and apt 3.0 refuses an unsigned repo fatally. The trust
## anchor is whoever owns the repo directory tree (root on /srv, or the build
## user who produced the .debs under test). Point it only at a root-owned-end-
## to-end path for an untrusted multi-user host; on a single-operator build/dev
## box the build user IS the trust anchor.

## local_apt_repo_sources_stanza <uri> <suite>
##   <uri>   complete apt URI, e.g. file:/srv/.../kicksecure or file:/mnt/local-apt-repo/kicksecure
##   <suite> reprepro codename, normally 'local'
## Emits one deb822 stanza on stdout (no leading blank line; a caller appending
## to a multi-stanza file adds its own separator).
local_apt_repo_sources_stanza() {
  local local_apt_repo_sources_stanza_uri local_apt_repo_sources_stanza_suite
  local_apt_repo_sources_stanza_uri="${1:-}"
  local_apt_repo_sources_stanza_suite="${2:-}"

  if [ -z "${local_apt_repo_sources_stanza_uri}" ] \
    || [ -z "${local_apt_repo_sources_stanza_suite}" ]; then
    return 2
  fi

  printf '%s\n' "Types: deb
URIs: ${local_apt_repo_sources_stanza_uri}
Suites: ${local_apt_repo_sources_stanza_suite}
Components: main contrib non-free
Enabled: yes
Trusted: yes"
}

## local_apt_repo_base_stanza <cache_root> <nick> <suite> <arch> [<uri_root>]
##   Emit a deb822 'deb' stanza for ONE Debian-base suite served from a local Debian mirror exposed
##   file-based (bind-mounted under the shared folder). Includes ONLY the components whose Packages
##   index is actually PRESENT on disk, in ANY form: a mirror stores the compressed index
##   (Packages.gz / Packages.xz) and typically NO uncompressed Packages and NO by-hash tree, so the
##   residency test accepts any of those. This stays generic for a PARTIAL mirror too: a component
##   the signed InRelease OFFERS but whose index is ABSENT makes 'apt-get update' HARD-FAIL (exit
##   100), so an offered-but-absent component is filtered out; a component the suite does not offer
##   is simply skipped by apt.
##   The Release is GENUINE Debian-signed, so NO 'Trusted: yes' (it verifies against the shipped
##   debian-archive-keyring). Prints nothing and returns 1 when the suite's InRelease is absent or
##   NO component is resident -- the caller then emits no stanza for it, so apt falls back to the
##   suite's normally-configured (e.g. Tor) source.
##     <cache_root> directory holding <nick>/dists/... to READ residency from (e.g. the host-side
##                  bind-mount /srv/derivative-maker/.../aptcache)
##     <nick>       mirror archive subdir (e.g. debian, debian-security)
##     <suite>      suite/codename (e.g. trixie, trixie-updates, trixie-security)
##     <arch>       binary arch (dpkg --print-architecture, e.g. amd64)
##     <uri_root>   OPTIONAL file: path to put in the EMITTED URI (default <cache_root>). Lets a
##                  host-side caller read the mirror at its host path yet emit the GUEST mount path
##                  (e.g. read /srv/.../aptcache, emit file:/mnt/shared/aptcache).
local_apt_repo_base_stanza() {
  local local_apt_repo_base_stanza_cache local_apt_repo_base_stanza_nick
  local local_apt_repo_base_stanza_suite local_apt_repo_base_stanza_arch
  local local_apt_repo_base_stanza_dists local_apt_repo_base_stanza_inrel
  local local_apt_repo_base_stanza_resident local_apt_repo_base_stanza_bdir
  local local_apt_repo_base_stanza_hash local_apt_repo_base_stanza_path local_apt_repo_base_stanza_comp
  local local_apt_repo_base_stanza_uri
  local_apt_repo_base_stanza_cache="${1:-}"
  local_apt_repo_base_stanza_nick="${2:-}"
  local_apt_repo_base_stanza_suite="${3:-}"
  local_apt_repo_base_stanza_arch="${4:-}"
  local_apt_repo_base_stanza_uri="${5:-${local_apt_repo_base_stanza_cache}}"
  if [ -z "${local_apt_repo_base_stanza_cache}" ] || [ -z "${local_apt_repo_base_stanza_nick}" ] \
    || [ -z "${local_apt_repo_base_stanza_suite}" ] || [ -z "${local_apt_repo_base_stanza_arch}" ]; then
    return 2
  fi

  local_apt_repo_base_stanza_dists="${local_apt_repo_base_stanza_cache}/${local_apt_repo_base_stanza_nick}/dists/${local_apt_repo_base_stanza_suite}"
  local_apt_repo_base_stanza_inrel="${local_apt_repo_base_stanza_dists}/InRelease"
  [ -r "${local_apt_repo_base_stanza_inrel}" ] || return 1

  ## Each 'SHA256' entry '<64-hex> <size> <comp>/binary-<arch>/Packages' names a component the
  ## suite offers; keep it only when its Packages index is on disk in ANY form -- compressed
  ## (.gz/.xz), flat, or that entry's by-hash file. A mirror normally stores only the compressed
  ## index (no uncompressed Packages, no by-hash), so checking the uncompressed Packages / its
  ## by-hash alone would wrongly find nothing; checking .gz/.xz covers it. The 64-hex field is the
  ## uncompressed-Packages hash (used for the by-hash lookup when a by-hash tree IS present); the
  ## 64-hex anchor also confines the grep to the SHA256 section (MD5Sum hashes are 32-hex).
  local_apt_repo_base_stanza_resident=""
  while read -r local_apt_repo_base_stanza_hash _ local_apt_repo_base_stanza_path; do
    local_apt_repo_base_stanza_comp="${local_apt_repo_base_stanza_path%%/binary-"${local_apt_repo_base_stanza_arch}"/Packages}"
    [ "${local_apt_repo_base_stanza_comp}" != "${local_apt_repo_base_stanza_path}" ] || continue
    ## A real component is a single path segment (main, contrib, ...). A multi-segment name is a
    ## SUB-index, e.g. 'main/debian-installer' (udebs) -- NOT a component; emitting it would make
    ## apt load the installer udebs as ordinary packages. Skip anything with a '/'.
    case "${local_apt_repo_base_stanza_comp}" in
      */*)
        continue
        ;;
    esac
    local_apt_repo_base_stanza_bdir="${local_apt_repo_base_stanza_dists}/${local_apt_repo_base_stanza_comp}/binary-${local_apt_repo_base_stanza_arch}"
    ## Require a NON-empty index (-s): a 0-byte Packages.gz from a truncated sync would pass -e but
    ## make apt-get update hard-fail; the genuine signed Release still verifies content.
    if [ -s "${local_apt_repo_base_stanza_bdir}/Packages.gz" ] \
      || [ -s "${local_apt_repo_base_stanza_bdir}/Packages.xz" ] \
      || [ -s "${local_apt_repo_base_stanza_bdir}/Packages" ] \
      || [ -s "${local_apt_repo_base_stanza_bdir}/by-hash/SHA256/${local_apt_repo_base_stanza_hash}" ]; then
      case " ${local_apt_repo_base_stanza_resident} " in
        *" ${local_apt_repo_base_stanza_comp} "*)
          ;;
        *)
          local_apt_repo_base_stanza_resident="${local_apt_repo_base_stanza_resident:+${local_apt_repo_base_stanza_resident} }${local_apt_repo_base_stanza_comp}"
          ;;
      esac
    fi
  done < <(grep -E "^ [0-9a-f]{64} +[0-9]+ [^ ]+/binary-${local_apt_repo_base_stanza_arch}/Packages\$" -- "${local_apt_repo_base_stanza_inrel}")

  [ -n "${local_apt_repo_base_stanza_resident}" ] || return 1

  ## No 'Trusted: yes': the genuine signed InRelease verifies against debian-archive-keyring.
  ## 'Architectures: <arch>' restricts the source to the arch the mirror actually holds -- without
  ## it, a multi-arch guest (e.g. i386 added) would ask this file: source for an absent foreign-arch
  ## index and apt-get update would hard-fail (exit 100).
  printf '%s\n' "Types: deb
URIs: file:${local_apt_repo_base_stanza_uri}/${local_apt_repo_base_stanza_nick}
Suites: ${local_apt_repo_base_stanza_suite}
Components: ${local_apt_repo_base_stanza_resident}
Architectures: ${local_apt_repo_base_stanza_arch}
Enabled: yes"
}
