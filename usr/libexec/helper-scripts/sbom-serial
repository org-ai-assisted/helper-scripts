## Print the RFC 4122 v5 (SHA-1) UUID of a name over the URL namespace.
##
## derivative-sbom uses this for the CycloneDX document serial. Computing it
## from the Python stdlib means the serial needs no uuidgen / uuid-runtime --
## not a helper-scripts dependency, absent on minimal and CI environments, where
## a uuidgen-based serial aborts the build.
##
## Byte-for-byte drop-in for 'uuidgen --sha1 --namespace @url --name <name>':
## uuid.uuid5 encodes the name as UTF-8 and would raise on a name that is not
## valid UTF-8, whereas uuidgen hashes the raw argument bytes. So hash the raw
## bytes directly (recovered from argv via os.fsencode / surrogateescape); the
## result is identical to uuidgen for ASCII, well-formed UTF-8, AND arbitrary
## bytes, and never crashes on a malformed name.
##
## Usage: sbom-serial <name>

import hashlib
import os
import sys
import uuid


def main() -> None:
    if len(sys.argv) != 2:
        print(
            f"{sys.argv[0]}: ERROR: expected exactly one <name> argument",
            file=sys.stderr,
        )
        sys.exit(1)
    name_bytes = os.fsencode(sys.argv[1])
    digest = hashlib.sha1(uuid.NAMESPACE_URL.bytes + name_bytes).digest()
    print(uuid.UUID(bytes=digest[:16], version=5))


if __name__ == "__main__":
    main()
