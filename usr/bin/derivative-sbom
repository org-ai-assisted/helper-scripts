#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## provides was_executed
# shellcheck source=../libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh || true
if ! declare -F was_executed >/dev/null; then
   printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh!" >&2
   exit 1
fi

## Generate a CycloneDX software bill of materials (SBOM) describing the
## currently installed system, from the live dpkg database via debsbom.
##
## One tool, two callers:
##   - the image build (initializer-dist chroot-scripts-post.d/76_sbom) calls it
##     with a pinned --timestamp to embed a reproducible, as-built SBOM.
##   - a user on a running system calls it AFTER upgrades to get an up-to-date
##     SBOM reflecting the current package set (the embedded, as-built SBOM is a
##     point-in-time record and is NOT refreshed by apt; regenerate on demand):
##        derivative-sbom > my-system.cdx.json
##        sudo derivative-sbom --out /usr/share/sbom/system.cdx.json
##
## The root component is named for the DERIVATIVE (Kicksecure / Whonix) via the
## canonical in-image marker files, not os-release (whose ID stays 'debian');
## the Debian package purls are unaffected.
##
## Components not managed by dpkg (Tor Browser, a tarball downloaded by
## tb-updater) are contributed as CycloneDX fragments dropped into
## /usr/share/sbom/fragments.d by their installer and merged into the output;
## see derivative_sbom_generate and sbom-fragment-merge.

## Resolve the derivative identity from the canonical in-image marker files, NOT
## by reading os-release's ID (which stays 'debian' on a derivative). Whonix is
## built on Kicksecure, so its marker wins; a plain (non-derivative) image falls
## back to os-release ID/VERSION_ID. Sets the globals distro_id, distro_version.
## SBOM_ETC_DIR is env-overridable ONLY so a unit test can point the reads at a
## tmpdir fixture; unset (production) it is /etc.
derivative_sbom_identity() {
   local etc_dir
   etc_dir="${SBOM_ETC_DIR:-/etc}"
   if [ -r "${etc_dir}/whonix_version" ]; then
      distro_id="Whonix"
      distro_version="$(cat -- "${etc_dir}/whonix_version")"
   elif [ -r "${etc_dir}/kicksecure_version" ]; then
      distro_id="Kicksecure"
      distro_version="$(cat -- "${etc_dir}/kicksecure_version")"
   elif [ -r "${etc_dir}/os-release" ]; then
      ## Unset first so a field os-release does NOT set (e.g. VERSION_ID on
      ## Debian sid) reads as empty, never inherited from the ambient environment.
      # shellcheck disable=SC1090
      distro_id="$(unset ID VERSION_ID VERSION; . "${etc_dir}/os-release"; printf '%s' "${ID:-debian}")"
      # shellcheck disable=SC1090
      distro_version="$(unset ID VERSION_ID VERSION; . "${etc_dir}/os-release"; printf '%s' "${VERSION_ID:-${VERSION:-}}")"
   else
      distro_id="debian"
      distro_version=""
   fi
}

## Document serial for an identity+timestamp: an RFC 4122 v5 (SHA-1) UUID over
## the URL namespace, computed by sbom-serial (uuid.uuid5) so the serial needs
## no uuidgen / uuid-runtime. Including the timestamp means a reproducible build
## (fixed --timestamp) is byte-identical across rebuilds, while a user
## regenerating later (timestamp = now) gets a DISTINCT serial, so two differing
## documents are not conflated under one id. Args: <name> <version> <arch>
## <timestamp>.
derivative_sbom_serial() {
   "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/sbom-serial \
      "sbom:${1}:${2}:${3}:${4}"
}

## True if the fragments drop-in directory holds at least one '*.cdx.json'.
## nullglob so an empty/absent directory yields an empty array rather than the
## literal glob.
derivative_sbom_have_fragments() {
   local frag_dir
   local -a matches
   frag_dir="$1"
   [ -d "${frag_dir}" ] || return 1
   shopt -s nullglob
   matches=( "${frag_dir}"/*.cdx.json )
   shopt -u nullglob
   [ "${#matches[@]}" -gt 0 ]
}

## Generate the SBOM to ${1} (a path, or '-' for stdout) with document timestamp
## ${2} (empty -> now). debsbom orders dependency edges via Python set iteration
## unless hash randomization is disabled, so pin PYTHONHASHSEED too.
##
## debsbom enumerates only dpkg-managed packages. Components installed into the
## image by other means (Tor Browser, a signed tarball downloaded by tb-updater,
## not a .deb) drop a CycloneDX fragment into SBOM_FRAGMENTS_DIR; when any exist
## the debsbom output is piped through sbom-fragment-merge to splice them into
## 'components'. With no fragments the output is byte-identical to debsbom's own,
## so a plain (no-downloaded-app) image is unaffected. SBOM_FRAGMENTS_DIR is
## env-overridable only so a unit test can point at a tmpdir fixture; unset
## (production) it is /usr/share/sbom/fragments.d.
derivative_sbom_generate() {
   local out timestamp distro_arch sbom_serial out_target frag_dir merge_tool
   out="$1"
   timestamp="$2"
   derivative_sbom_identity
   distro_arch="$(dpkg --print-architecture)"
   [ -n "${timestamp}" ] || timestamp="$(date --utc +%Y-%m-%dT%H:%M:%S+00:00)"
   export PYTHONHASHSEED=0
   sbom_serial="$(derivative_sbom_serial "${distro_id}" "${distro_version}" "${distro_arch}" "${timestamp}")"
   ## debsbom's own --out APPENDS '.cdx.json' unless the path already ends in it,
   ## so a plain '--out foo.json' writes 'foo.json.cdx.json'. Emit to stdout and
   ## redirect so the SBOM lands at EXACTLY ${out} (or stdout for '-').
   if [ "${out}" = "-" ]; then
      out_target="/dev/stdout"
   else
      out_target="${out}"
   fi
   frag_dir="${SBOM_FRAGMENTS_DIR:-/usr/share/sbom/fragments.d}"
   merge_tool="${HELPER_SCRIPTS_PATH:-}/usr/libexec/helper-scripts/sbom-fragment-merge"
   if derivative_sbom_have_fragments "${frag_dir}"; then
      debsbom generate \
         --sbom-type cdx \
         --cdx-schema-version 1.6 \
         --cdx-serialnumber "${sbom_serial}" \
         --timestamp "${timestamp}" \
         --distro-name "${distro_id}" \
         --distro-version "${distro_version}" \
         --out - \
         | "${merge_tool}" "${frag_dir}" > "${out_target}"
   else
      debsbom generate \
         --sbom-type cdx \
         --cdx-schema-version 1.6 \
         --cdx-serialnumber "${sbom_serial}" \
         --timestamp "${timestamp}" \
         --distro-name "${distro_id}" \
         --distro-version "${distro_version}" \
         --out - > "${out_target}"
   fi
}

main() {
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
   export LC_ALL=C

   local out timestamp
   out="-"
   timestamp=""
   while [ "$#" -gt 0 ]; do
      case "$1" in
         --out)
            [ "$#" -ge 2 ] || { printf '%s\n' "${0##*/}: --out requires a value" >&2; exit 64; }
            out="$2"
            shift 2
            ;;
         --timestamp)
            [ "$#" -ge 2 ] || { printf '%s\n' "${0##*/}: --timestamp requires a value" >&2; exit 64; }
            timestamp="$2"
            shift 2
            ;;
         -h|--help)
            printf '%s\n' \
               "Usage: ${0##*/} [--out FILE] [--timestamp ISO8601]" \
               "  --out FILE        write the CycloneDX SBOM to FILE (default: stdout)" \
               "  --timestamp TS    pin the document timestamp (default: now); the build" \
               "                    passes SOURCE_DATE_EPOCH for a reproducible result"
            exit 0
            ;;
         *)
            printf '%s\n' "${0##*/}: unknown argument: $1" >&2
            exit 64
            ;;
      esac
   done

   derivative_sbom_generate "${out}" "${timestamp}"
}

## Only auto-run when executed, not when sourced (unit tests source it).
if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
