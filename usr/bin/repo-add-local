#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Enable a derivative LOCAL apt repository on THIS system (write its deb822 sources
## stanza). It does NOT run apt-get update -- that is the caller's next step.
## The local repo is derivative-maker's reprepro 'local' repo (codename 'local'),
## built from source and delivered here by one of:
##   - a VirtualBox shared folder mounted at /mnt/shared (host-injected from the
##     build host by dm-shared-apt-repo) -- the DEFAULT; written to
##     /etc/apt/sources.list.d/local-apt-repo-mnt.sources;
##   - a repo materialised on this system under /srv (pass --repo-dir DIR) --
##     written to local-apt-repo-srv.sources, so it can coexist with the mnt one.
##
## Uniform on Kicksecure, Whonix-Gateway and Whonix-Workstation: a shared folder
## is host<->guest, not network, so a Workstation reaches it with no Gateway relay
## and no Tor. The slot of a laned build is resolved HOST-side (which directory is
## shared / bind-mounted), so this tool sees a slot-free path and needs no --slot.
##
## [trusted=yes] is intrinsic: apt 3.0 fatally refuses an unsigned repo. The trust
## anchor is whoever owns the delivered tree (a read-only vboxsf mount, or a
## root-/build-user-owned /srv). The deb822 stanza is emitted by the shared
## generator (local-apt-repo-sources.bsh) so it cannot drift from the build side.
##
## Run as root:  sudo repo-add-local [kicksecure|whonix] [--repo-dir DIR]

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"
guest_mount="/mnt/shared"
codename="local"

## Single source of truth for the deb822 stanza (this package's libexec).
# shellcheck source=../libexec/helper-scripts/local-apt-repo-sources.bsh
source "${HELPER_SCRIPTS_PATH:-}/usr/libexec/helper-scripts/local-apt-repo-sources.bsh"

die() {
   printf '%s\n' "${me}: ERROR: ${1}" >&2
   exit 1
}

[ "$(id -u)" -eq 0 ] || die "run as root (writes /etc/apt/sources.list.d and runs apt-get)"

derivative=""
repo_dir_override=""
location="mnt"
while [ "$#" -gt 0 ]; do
   case "$1" in
      --repo-dir)
         repo_dir_override="${2:-}"
         location="srv"
         shift 2
         ;;
      kicksecure|whonix)
         derivative="$1"
         shift
         ;;
      *)
         die "unknown argument: '$1' (usage: ${me} [kicksecure|whonix] [--repo-dir DIR])"
         ;;
   esac
done

## Derivative: explicit arg, else detect Whonix (ships anon-* / a whonix marker),
## else default kicksecure.
if [ -z "${derivative}" ]; then
   if grep --quiet --ignore-case 'whonix' /etc/os-release 2>/dev/null || [ -d /usr/share/whonix ]; then
      derivative="whonix"
   else
      derivative="kicksecure"
   fi
fi

if [ -n "${repo_dir_override}" ]; then
   repo_dir="${repo_dir_override}"
else
   ## Host-injected shared folder. The mount is Kicksecure's job: vm-config-dist's
   ## mnt-shared-vbox.service mounts 'shared' to /mnt/shared every boot; restart it
   ## if not mounted yet -- never reimplementing its mount logic.
   if ! mountpoint --quiet -- "${guest_mount}"; then
      printf '%s\n' "${me}: ${guest_mount} not mounted; restarting mnt-shared-vbox.service"
      systemctl restart mnt-shared-vbox.service || true
      mountpoint --quiet -- "${guest_mount}" \
         || die "${guest_mount} still not mounted -- is the 'shared' folder attached? (host: dm-shared-apt-repo attach <vm>)"
   fi
   repo_dir="${guest_mount}/aptrepo_local/${derivative}"
   ## apt over this read-only vboxsf mount: the _apt sandbox user cannot read it
   ## (vboxsf perms come from the mount options, umask 0007, not the inode mode -- a
   ## chmod/ACL in the guest is a no-op), so a later 'apt-get update' prints a benign
   ## "Err: ... Permission denied" + "Download is performed unsandboxed as root" and
   ## retries as root, which succeeds via [trusted=yes]. Expected; accepted as-is.
fi

[ -d "${repo_dir}/dists/${codename}" ] \
   || die "no '${codename}' repo at ${repo_dir} (host: populate it with 'derivative-maker --skip-published-packages' and deliver it)"

## deb822 stanza MUST live in a .sources file (apt ignores a stanza in a .list).
## Distinct name per location so a /srv and a /mnt repo can be enabled at once.
## The sources.list.d dir is an env seam (trusted env) so the tool is testable
## without writing to the real /etc/apt; production is the unset default.
apt_sources_list_d="${REPO_ADD_LOCAL_SOURCES_LIST_D:-/etc/apt/sources.list.d}"
list_file="${apt_sources_list_d}/local-apt-repo-${location}.sources"
local_apt_repo_sources_stanza "file:${repo_dir}" "${codename}" > "${list_file}"
printf '%s\n' "${me}: wrote ${list_file}:"
cat -- "${list_file}"

printf '%s\n' "${me}: enabled. Next: apt-get update && apt-get install --only-upgrade <pkg>"
